generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  children     Child[]
  consultationBookings ConsultationBooking[]
}

model ConsultationExpert {
  id         String @id @default(cuid())
  name       String
  role       String
  specialty  String
  rating     Float
  reviews    Int
  price      Int
  duration   Int
  image      String
  slots      Json
  bookings   ConsultationBooking[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ConsultationBooking {
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertId    String
  expert      ConsultationExpert @relation(fields: [expertId], references: [id])
  scheduledAt DateTime
  duration    Int
  price       Int
  notes       String?
  status      String @default("pending")
  paymentStatus String @default("simulated")
  videoCallStatus String @default("simulated")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, scheduledAt])
}

model Child {
  id                  String              @id @default(cuid())
  parentId            String
  parent              User                @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name                String
  age                 Int
  avatar              String?
  interests           Json
  learningPreferences Json
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  quizAttempts        QuizAttempt[]
  lessonProgress      LessonProgress[]
  simulationSessions  SimulationSession[]
  learningSessions    LearningSession[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  thumbnail   String?
  category    String
  difficulty  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
}

model Lesson {
  id             String           @id @default(cuid())
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  description    String
  content        String
  visual         String?
  videoUrl       String?
  activityPrompt String
  activityAnswer String
  order          Int
  duration       Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  quizQuestions  QuizQuestion[]
  quizAttempts   QuizAttempt[]
  progress       LessonProgress[]
  learningSessions LearningSession[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  lessonId      String
  lesson        Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question      String
  options       Json
  correctAnswer String
  explanation   String
}

model QuizAttempt {
  id          String   @id @default(cuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  score       Int
  completedAt DateTime @default(now())
}

model LessonProgress {
  id          String    @id @default(cuid())
  childId     String
  child       Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  progress    Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([childId, lessonId])
}

model LearningSession {
  id              String   @id @default(cuid())
  childId         String
  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationSeconds Int?

  @@index([childId, startedAt])
}

model Simulation {
  id          String              @id @default(cuid())
  title       String
  description String
  scenario    String
  difficulty  String
  systemPrompt String
  createdAt   DateTime            @default(now())
  sessions    SimulationSession[]
}

model SimulationSession {
  id           String              @id @default(cuid())
  childId      String
  child        Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  simulationId String
  simulation   Simulation          @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  status       String              @default("ACTIVE")
  startedAt    DateTime            @default(now())
  completedAt  DateTime?
  messages     SimulationMessage[]
}

model SimulationMessage {
  id        String            @id @default(cuid())
  sessionId String
  session   SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime          @default(now())
}
