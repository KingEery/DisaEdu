{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NODE_PATH": "./backend/node_modules"
  },
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "express",
      "installCommand": "npm install",
      "buildCommand": "npm run build"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
